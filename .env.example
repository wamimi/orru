# Privy (app flow). App ID is public; secret is server-only.
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
SESSION_SECRET=

# Optional — without these, waitlist signups are logged on the server only.

# Preferred: webhook (Make, n8n, Zapier, Slack, Notion, etc.)
WAITLIST_WEBHOOK_URL=

# Or: get an email for each signup via FormSubmit (no API key).
# Set this in .env.local AND in Vercel → Settings → Environment Variables,
# then confirm the first activation email FormSubmit sends you.
WAITLIST_NOTIFY_EMAIL=

# Or: Resend
RESEND_API_KEY=
WAITLIST_FROM_EMAIL=orru <onboarding@resend.dev>
SEPOLIA_RPC_URL=
BASE_SEPOLIA_RPC_URL=
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
RELAYER_PRIVATE_KEY=
ETHERSCAN_API_KEY=
USDC_ADDRESS=
PAYER_ANCHOR_ADDRESS=
DEMO_PAYROLL_ADDRESS=
PAYROLL_OWNER=
PAYROLL_KEEPER=
PERIOD_SECONDS=14400
SOURCE_CHAIN_KEY=1

# --- Creditcoin deployment (script/deploy-creditcoin.sh) --------------------
CREDITCOIN_CHAIN_ID=102031
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network/

# Foundry keystore that deploys and owns the Creditcoin contracts.
DEPLOYER_ACCOUNT=cc3-deployer
# Optional. Without it forge prompts; set it for unattended runs.
DEPLOYER_PASSWORD_FILE=
# Optional. Lets a dry run check the balance without unlocking the keystore.
DEPLOYER_ADDRESS=
# Optional. Owner of the Creditcoin contracts; defaults to the deployer.
CREDITCOIN_OWNER=

# Comma-separated payroll addresses to approve on AttestationRegistry.
# Defaults to DEMO_PAYROLL_ADDRESS. A payer that is not approved has its logs
# ignored, and execute() reverts NoTrustedLogs.
CREDITCOIN_PAYERS=
# mUSDC base units minted into DemoCreditPool. Six decimals: 1e12 = 1,000,000.
POOL_FUNDING=1000000000000

# Written by script/deploy-creditcoin.sh; the worker reads them.
ATTESTATION_REGISTRY_ADDRESS=
CREDENTIAL_REGISTRY_ADDRESS=

# --- Browser proving --------------------------------------------------------
# Payment preimages for payers whose salts are secret. fixtures/slips.json holds
# only the payers whose salts the source chain already publishes; anything
# private lives here instead, and never in the repository. One JSON line, from:
#   cd worker && npx tsx src/index.ts export-witness -- --private
ORRU_SLIP_BOOKS=

# Cross-origin isolation, which is what lets the prover use every core.
# `credentialless` (default) isolates without blocking third-party frames.
# `require-corp` is stricter and commonly breaks wallet connectors.
# `off` disables isolation: proving still works, single-threaded.
ORRU_COEP=credentialless

# Set to 1 to issue from the pre-built statement instead of building one in the
# browser. A fallback for the demo only — the privacy claim depends on proving
# happening on the user's own machine.
NEXT_PUBLIC_ORRU_PREBUILT=

# --- Try-it faucet -----------------------------------------------------------
# Lets anyone give a wallet a demo income history so they can walk the whole
# journey without being on the payroll. Both must be set or the faucet is off.
#
# Any long random string. Salts are derived from it rather than stored, so a
# claim needs no database — but changing it orphans every existing claim.
ORRU_FAUCET_SECRET=

# The payer that anchors the claim on Ethereum. Must be an approved payer in
# AttestationRegistry and hold Sepolia ETH for gas.
ORRU_FAUCET_PAYER=0x0531203274075Ff79A07000BBDa2B0272C647d01
ORRU_FAUCET_PAYER_KEY=
