# Created by https://www.toptal.com/developers/gitignore/api/node,nextjs
# Edit at https://www.toptal.com/developers/gitignore?templates=node,nextjs

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
.data/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# ---------------------------------------------------------------------------
# Orru — Foundry, Noir, and agent tooling
# NOTE: entries below are intentionally NOT root-anchored (no leading slash),
# so they match at any depth. The Next.js block above uses /out/, /node_modules
# etc., which would NOT catch contracts/out or contracts/node_modules.
# ---------------------------------------------------------------------------

# Foundry build artifacts (contracts/)
out/
cache/
broadcast/
artifacts/

# Foundry dependencies are COMMITTED (lib/forge-std), installed with
# `forge install --no-git` so no git submodule is added to the parent repo.
# A fresh clone must build with no undocumented bootstrap step.

# npm inside contracts/ (@gluwa/usc-contracts is a Solidity source dependency)
node_modules/

# Noir / Barretenberg build output (circuits/**)
target/
*.gz

# Local Foundry / deploy state
.env.*
!.env.example
cache_hardhat/

# Agent tooling
.claude/skills/

# Audit skill output (pashov/skills)
x-ray/
fizz_data/

# ---------------------------------------------------------------------------
# Not for the remote
# ---------------------------------------------------------------------------

# Audit output — contains UNFIXED findings and exploit traces. Must not be
# public before the deadline, and ideally not after without a re-review.
contracts/audit-report*.md
contracts/.audit-*/

# Audit tooling scratch directories, wherever they land. Not root-anchored on
# purpose — these appear at whatever depth the tool is run from.
.audit-*/
*-pashov-ai-audit-report-*.md

# Internal strategy, specs and handoffs — competitive analysis, cut order,
# disclosure list. Kept local.
#
# NOTE: this is `docs/*`, not `docs/`. Git cannot re-include a file whose parent
# DIRECTORY is excluded, so excluding the contents is what makes the negation
# below work at all.
docs/*

# ...except the one document the frontend is built against. Delete this line if
# the whole docs tree should stay local.
!docs/FRONTEND-INTEGRATION.md

# Worker scan state and generated proofs
worker/state/

# Off-chain payment slips. These hold the PRIVATE witness — amounts and the
# random salts that make the commitments hiding. The chain never sees them and
# neither should the remote.
worker/slips/

# Generated by worker/src/prove.ts on every run. Holds the PRIVATE witness —
# the actual salary amounts the proof exists to keep secret.
circuits/*/Prover.toml

contracts/audit-report.md
