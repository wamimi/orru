# The worker reads contracts/.env first, then this file on top. Anything already
# set there — RPC URLs, contract addresses — does not need repeating here.
# Override the whole lookup with ORRU_ENV_FILE=/path/to/file.

# --- source chain -----------------------------------------------------------
SEPOLIA_RPC_URL=
PAYER_ANCHOR_ADDRESS=0x16EaB9DA91D2AEea1F1138A95E42C37d1D47B7d2

# Comma-separated. More than one payroll may anchor to the same PayerAnchor, and
# each is a separate payer with its own period numbering.
DEMO_PAYROLL_ADDRESS=

# The block PayerAnchor was deployed in. Scanning from 0 works but is slow.
WORKER_START_BLOCK=11605464

# --- Attestcoin source chain key, NOT an EVM chain id ------------------------
# Creditcoin testnet: Ethereum Sepolia = 1, Ethereum mainnet = 3.
SOURCE_CHAIN_KEY=1

# --- Creditcoin -------------------------------------------------------------
CREDITCOIN_RPC_URL=https://rpc.cc3-testnet.creditcoin.network
CREDITCOIN_CHAIN_ID=102031
PROOF_BUILDER_URL=https://prover.cc3-testnet.creditcoin.network/

# Set once the Creditcoin side is deployed.
ATTESTATION_REGISTRY_ADDRESS=
CREDENTIAL_REGISTRY_ADDRESS=

# --- discovery --------------------------------------------------------------
# With a key the worker uses the Etherscan v2 log API, which takes any block
# range in one request. Without one it falls back to eth_getLogs, which free
# tiers cap at ten blocks. Neither is trusted: commitments are recomputed
# locally and every payment is re-proved through Attestcoin.
ETHERSCAN_API_KEY=
# Force a backend: etherscan | rpc
# WORKER_LOG_SOURCE=

# --- relayer key, only needed for `attest --submit` --------------------------
# Preferred: an encrypted Foundry keystore. Never a plaintext key in this file.
# WORKER_ACCOUNT=orru-keeper
# WORKER_PASSWORD_FILE=/absolute/path/to/password
# WORKER_KEYSTORE_PATH=/absolute/path/to/keystore.json
# WORKER_PRIVATE_KEY=

# --- tuning -----------------------------------------------------------------
# WORKER_CONFIRMATIONS=5
# WORKER_CHECKPOINT=2000
# WORKER_CONCURRENCY=8
# WORKER_ATTEST_LOOKAHEAD=10
# WORKER_POLL_MS=5000
# WORKER_WAIT_MS=1200000
